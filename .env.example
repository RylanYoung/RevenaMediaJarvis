# Revena Media Dashboard — environment variable template.
# This file IS committed (unlike .env.local / .env*) so the required keys
# are documented in the repo. Copy it to .env.local and fill in real values,
# then add the same keys in Vercel under Project Settings -> Environment
# Variables when you deploy.

# --- Password protection ---
# Shared password for the whole dashboard (no user accounts, just one gate).
# Required for the proxy.ts login screen to work — leave blank locally only
# if you're fine with the dashboard being unlocked while you develop.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Supabase (not wired up yet — add later when the database is set up) ---
# Project URL, e.g. https://xxxxx.supabase.co — from Supabase project settings > API
SUPABASE_URL=
# Public anon key — from Supabase project settings > API (safe for client use, RLS still required)
SUPABASE_ANON_KEY=
# Service role key — from Supabase project settings > API. SERVER-SIDE ONLY,
# never exposed to the browser. Used by /api/sync/lead-distro to write past RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Lead Distro API ---
# API key for pulling B2C leads, campaign performance, and B2C ad spend
LEAD_DISTRO_API_KEY=
# Campaign UUID to sync — find it in Lead Distro under the campaign's URL/settings
LEAD_DISTRO_CAMPAIGN_ID=

# --- Meta Marketing API (B2B ad account) ---
# Ad account ID for the B2B ad account, e.g. act_1234567890
META_AD_ACCOUNT_ID=
# Long-lived access token with ads_read permission for the Meta Marketing API
META_ACCESS_TOKEN=

# --- Stripe ---
# Secret key (starts with sk_live_ or sk_test_) — powers Revenue in Financials/Overview
STRIPE_SECRET_KEY=
# Webhook signing secret (starts with whsec_) — from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=

# --- Cron auth ---
# Random secret used to authorize Vercel Cron's daily sync requests
CRON_SECRET=
